{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/steuerstand.mjs\" nach-compact",
            "timeout": 10,
            "statusMessage": "Steuerstand wieder einlesen"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/steuerstand.mjs\" vor-compact",
            "timeout": 10,
            "statusMessage": "Alter des Steuerstands pruefen"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/steuerstand.mjs\" sitzungsstart",
            "timeout": 10,
            "statusMessage": "Steuerstand einlesen"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/steuerstand.mjs\" erinnern",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
