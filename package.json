{
  "name": "onlinegames",
  "version": "0.1.0",
  "description": "Spiele fuer mehrere, ueber einen Raumcode",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/*.test.mjs\" \"scripts/**/*.test.mjs\" && node --test \"tests/partien/*.test.mjs\"",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "waechter": "node --test \"tests/waechter-*.test.mjs\"",
    "typen": "tsc -p tsconfig.json && tsc -p public/tsconfig.json",
    "check": "npm run specs:check && npm run specs:belege && npm run qa:report && npm test",
    "check:kurz": "node scripts/leise.mjs check",
    "check:alles": "npm run test:e2e && npm run check",
    "check:alles:kurz": "node scripts/leise.mjs check:alles",
    "check:alles:neu": "node scripts/qa-nachweis-lauf.mjs && npm run check",
    "check:alles:neu:kurz": "node scripts/leise.mjs check:alles:neu",
    "specs:board": "node scripts/spec-board.mjs",
    "specs:check": "node scripts/spec-board.mjs --check",
    "specs:belege": "node scripts/check-belege.mjs",
    "qa:report": "node scripts/qa-report.mjs",
    "qa:abweichung": "node scripts/qa-abweichung.mjs",
    "qa:nachweis": "node scripts/qa-nachweis-lauf.mjs",
    "qa:waisen": "node scripts/qa-waisen.mjs",
    "e2e:browser": "playwright install chromium",
    "e2e:laufzeiten": "node scripts/e2e-laufzeiten.mjs",
    "e2e:daten": "playwright test --config e2e/playwright.config.mjs strategie-bauen strategie-dunkle-zeit strategie-feudalbauten strategie-feudalzeit strategie-ritterzeit strategie-ritterzeit-am-stueck strategie-figuren strategie-unterscheidbar strategie-laptop",
    "einladung": "node scripts/einladung.mjs",
    "sicht": "node scripts/sicht.mjs",
    "tafel": "node scripts/tafel.mjs",
    "pruefstand:strategie": "node scripts/pruefstand-strategie.mjs",
    "gegenprobe": "node scripts/gegenprobe.mjs",
    "durchsicht": "node scripts/durchsicht.mjs",
    "pruefstand:vergleich": "node scripts/pruefstand-vergleich.mjs",
    "pruefstand:verlauf": "node scripts/pruefstand-verlauf.mjs",
    "pruefstand:haeuser": "node scripts/pruefstand-haeuser.mjs",
    "konterkreis:strategie": "node scripts/konterkreis-strategie.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
